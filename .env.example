# Copia este archivo como .env (local) o define estas variables en Vercel › Settings › Environment Variables.
OPENROUTER_API_KEY=  # si esta vacio toma el ia simulada
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_TIMEOUT=70         # segundos por llamada al modelo
RESPALDO_SIMULADO=1           # 1 = si el modelo gratuito falla (cuota, 429, caída) responde la IA simulada y se marca; 0 = mostrar el error
DEMO_PIN=1234                 # PIN de la Administradora en la demo
MOSTRAR_PIN_DEMO=1            # 1 = el Panel de demo muestra el PIN; 0 = ocultarlo
DEMO_CODIGO_ACCESO=           # opcional: si lo defines, la demo pide este código antes de entrar
LIMITE_IA_POR_MINUTO=15       # tope de llamadas a la IA por sesión de demo y minuto
# Las agrega solo la integración de Upstash en Vercel (no las escribas a mano):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
